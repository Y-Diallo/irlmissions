rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // All browser access stays behind scoped Next routes. The OBS overlay
      // receives only the allowlisted publicState projection through its own
      // read-key endpoint; it never receives Firebase or owner credentials.
      allow read, write: if false;
    }
  }
}
