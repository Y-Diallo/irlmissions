# Copy to .env.local for credential-free local development.
# Never use emulator mode for a deployed build.
NEXT_PUBLIC_APP_MODE=emulator
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-irlmissions
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-irlmissions.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Admin SDK emulator addresses omit http://. Both are mandatory in demo mode.
FIREBASE_PROJECT_ID=demo-irlmissions
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Live mode: set NEXT_PUBLIC_APP_MODE=live, replace Firebase config above,
# and REMOVE all four emulator-host variables. Set the owner Twitch ID.
# On App Hosting use Application Default Credentials, never a public key file.
# For local live access, set GOOGLE_APPLICATION_CREDENTIALS to an ignored key
# file outside this repo or use gcloud application-default credentials.
# For ADC signing, the caller needs iam.serviceAccounts.signBlob permission.
# Set this when using local user ADC or explicitly selecting a signer:
# FIREBASE_SERVICE_ACCOUNT_ID=your-signer@your-project.iam.gserviceaccount.com
# TWITCH_OWNER_ID=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback
# Register that exact callback in the Twitch developer console.
# TWITCH_EVENTSUB_SECRET=
# TWITCH_REWARD_ID=
# GOOGLE_MAPS_API_KEY=
# OPENAI_API_KEY=
# REALTIMEIRL_PULL_KEY=
